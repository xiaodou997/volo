{
  "manifestVersion": 2,
  "id": "volo-uuid-gen",
  "name": "UUID 生成",
  "version": "1.0.0",
  "description": "生成 UUID 并复制到剪贴板",
  "contributes": {
    "commands": [
      {
        "id": "gen-uuid",
        "name": "生成 UUID",
        "keywords": ["uuid", "guid"],
        "description": "生成 UUID v4 并复制到剪贴板",
        "run": "command.js"
      }
    ]
  },
  "permissions": ["clipboard.write", "notification.show"]
}
